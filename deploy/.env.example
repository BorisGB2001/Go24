# boris.gb 2026-10-11 13:32 - шаблон настроек стека go24; скопировать в deploy/.env и заполнить (make secrets сгенерирует пароли)

# IP, на котором публикуются порты. 127.0.0.1 — только локально, снаружи доступ через SSH-туннель (make tunnel)
# boris.gb 2026-10-11 14:37 - на сервере разработки: адрес в частной сети (192.168.1.15), чтобы браузер и go24 видели Authentik по одному адресу
# boris.gb 2026-10-11 13:42 - NetBird исключён из стека, BIND_IP больше не указывает на сеть NetBird
BIND_IP=127.0.0.1

# PostgreSQL
PG_SUPERUSER_PASSWORD=
GO24_DB_PASSWORD=
AUTHENTIK_DB_PASSWORD=

# Authentik
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=

# go24
GO24_BASE_URL=http://127.0.0.1:8080
# boris.gb 2026-10-13 01:30 - часовой пояс go24 (IANA); по умолчанию Europe/Amsterdam, как на dev-сервере
GO24_TZ=Europe/Amsterdam
GO24_SESSION_SECRET=
# boris.gb 2026-10-11 14:37 - приложение go24 в Authentik создаёт blueprint deploy/authentik/blueprints/go24.yaml из этих значений;
# CLIENT_ID/SECRET генерирует make secrets, ISSUER = http://<BIND_IP>:9000/application/o/go24/
GO24_OIDC_ISSUER=
GO24_OIDC_CLIENT_ID=
GO24_OIDC_CLIENT_SECRET=

# Файлы: rclone serve s3. RCLONE_REMOTE — remote из deploy/rclone/rclone.conf, например fileserver:/srv/go24-files
# boris.gb 2026-10-11 13:41 - self-hosted: по умолчанию локальный том; облачные хранилища не используем
RCLONE_REMOTE=local:/data
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=go24
# boris.gb 2026-10-11 16:30 - пароль API rclone rcd (раздел «Хранилища»), генерирует make secrets
RCLONE_RC_PASS=
# boris.gb 2026-10-26 12:31 - «Хранилища» Google Диск, Dropbox, OneDrive (GO24DEV-643): приложение go24 в Google Cloud Console
# (Drive API, OAuth-клиент «Web»), Dropbox App Console, Microsoft Entra; адрес возврата https://<go24>/settings/storages/oauth
GO24_GDRIVE_CLIENT_ID=
GO24_GDRIVE_CLIENT_SECRET=
GO24_DROPBOX_CLIENT_ID=
GO24_DROPBOX_CLIENT_SECRET=
GO24_ONEDRIVE_CLIENT_ID=
GO24_ONEDRIVE_CLIENT_SECRET=
# boris.gb 2026-10-27 22:49 - «Почта» входом в аккаунт (GO24DEV-803): Google Cloud Console (Gmail API, область https://mail.google.com/),
# Microsoft Entra (IMAP.AccessAsUser.All, SMTP.Send, offline_access), oauth.yandex.ru (mail:imap_full, mail:smtp, login:email);
# адрес возврата https://<go24>/mail/oauth; пусто у Google и Microsoft — берутся приложения «Хранилищ»
GO24_MAIL_GOOGLE_CLIENT_ID=
GO24_MAIL_GOOGLE_CLIENT_SECRET=
GO24_MAIL_MICROSOFT_CLIENT_ID=
GO24_MAIL_MICROSOFT_CLIENT_SECRET=
GO24_MAIL_YANDEX_CLIENT_ID=
GO24_MAIL_YANDEX_CLIENT_SECRET=
# boris.gb 2026-10-12 06:57 - токен служебной учётки go24-sync в Authentik (make secrets заполнит)
GO24_AUTHENTIK_TOKEN=
# boris.gb 2026-10-12 07:16 - мессенджер на Matrix (Synapse + Element): make secrets заполнит пароли, адреса — под свой сервер
MATRIX_SERVER_NAME=go24.lan
MATRIX_PUBLIC_URL=https://127.0.0.1:8448
MATRIX_ELEMENT_URL=https://127.0.0.1:8443
GO24_OIDC_ISSUER_BASE=http://127.0.0.1:9000
MATRIX_OIDC_SKIP_VERIFICATION=false
SYNAPSE_DB_PASSWORD=
SYNAPSE_REGISTRATION_SECRET=
SYNAPSE_MACAROON_SECRET=
SYNAPSE_FORM_SECRET=
MATRIX_OIDC_CLIENT_ID=
MATRIX_OIDC_CLIENT_SECRET=
# boris.gb 2026-10-21 23:23 - «Документы онлайн» (GO24DEV-231): JWT-секрет сервера документов ONLYOFFICE и go24 (make secrets заполнит)
ONLYOFFICE_JWT_SECRET=
# boris.gb 2026-10-25 14:10 - телефония (GO24DEV-501): пароль REST-интерфейса (ARI) Asterisk для go24 (make secrets заполнит)
ASTERISK_SECRET=
# boris.gb 2026-10-25 23:55 - «Резервное копирование» (GO24DEV-569): папка сервера для копий (по умолчанию deploy/backups); лучше — другой диск
#GO24_BACKUP_DIR=/mnt/backup/go24
